   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "def encode_dataframe(df):\n",
    "    le = LabelEncoder()\n",
    "\n",
    "    for col in df.select_dtypes(include='object').columns:\n",
    "        df[col] = le.fit_transform(df[col].astype(str))\n",
    "\n",
    "    return df"
   ]
